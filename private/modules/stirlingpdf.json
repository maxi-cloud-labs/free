{
	"module": "stirlingpdf",
	"name": "Stirling-PDF",
	"title": "PDF Manipulation Tool",
	"category": "Productivity",
	"version": "v2.5.3",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "SQLite",
	"github": "Stirling-Tools/Stirling-PDF",
	"description": "An all-in-one PDF editor for merging, splitting, converting, securing, and processing documents.",
	"hero": "a muscular mechanic with a Stirling engine arm splitting and merging PDF pages like a blacksmith. industrial-retro, hardy, craft",
	"keywords": [
		"compression",
		"conversion",
		"document",
		"merging",
		"ocr",
		"redaction",
		"signing",
		"splitting"
	],
	"proprietary": [
		"Adobe Acrobat",
		"Foxit PDF Editor",
		"Nitro PDF Pro"
	],
	"default": {
		"enabled": true,
		"localPort": 9575,
		"permissions": [
			"user"
		],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 8105,
				"path": "/"
			}
		],
		"services": [
			"stirlingpdf"
		],
		"setup": true,
		"setupDependencies": [
			"java"
		]
	}
}
