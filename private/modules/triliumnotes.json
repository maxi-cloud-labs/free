{
	"module": "triliumnotes",
	"name": "Trilium Notes",
	"title": "Hierarchical Notes",
	"category": "Productivity",
	"version": "v0.95.0",
	"installMethod": "tar",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "SQLite",
	"github": "TriliumNext/Trilium",
	"description": "A hierarchical note-taking application for building structured personal knowledge bases.",
	"hero": "a towering hierarchical tree whose leaves are glowing notes, a vast knowledge forest. mystical, arboreal, expansive",
	"keywords": [
		"backlink",
		"hierarchy",
		"journaling",
		"knowledgebase",
		"markdown",
		"notebook",
		"organization",
		"outline"
	],
	"proprietary": [
		"Evernote",
		"Notion",
		"Obsidian"
	],
	"default": {
		"autoLogin": {
			"inject": [
				{
					"url": "/login",
					"form": "form[action=login]",
					"arg1": "input[name=password]",
					"arg2": "",
					"arg3": "button",
					"val1": 2,
					"val2": 4
				}
			],
			"post": [
				{
					"url": "/login",
					"arg1": "password",
					"arg2": "",
					"val1": 2,
					"val2": 4
				}
			]
		},
		"autoLoginNoGzip": [
			"^/login"
		],
		"config": true,
		"enabled": true,
		"localPort": 9543,
		"permissions": [
			"user"
		],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 8090,
				"path": "/"
			}
		],
		"services": [
			"triliumnotes"
		],
		"setup": true,
		"setupDependencies": []
	}
}