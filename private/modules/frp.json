{
	"module": "frp",
	"name": "frp",
	"title": "Reverse Proxy",
	"category": "Server",
	"version": "v0.63.0",
	"installMethod": "wget",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "",
	"github": "fatedier/frp",
	"description": "A reverse proxy and tunneling service for remote access to servers behind NAT or firewalls.",
	"hero": "a glowing tunnel piercing through a thick firewall brick wall, a small server on the far side shining out. escape-thriller, bold, clever",
	"keywords": [
		"exposure",
		"firewall",
		"forwarding",
		"nat",
		"port",
		"remote",
		"reverseproxy",
		"tunneling"
	],
	"proprietary": [
		"Cloudflare Tunnel",
		"Tailscale Funnel",
		"ngrok"
	],
	"default": {
		"bindingPort": 7000,
		"enabled": true,
		"localPort": 9455,
		"permissions": [],
		"permissionsPublicForbidden": true,
		"protocols": {
			"http": {
				"type": "http",
				"enabled": true,
				"localPort": 80
			},
			"https": {
				"type": "https",
				"enabled": true,
				"localPort": 443
			},
			"ssh": {
				"type": "tcp",
				"enabled": true,
				"localPort": 22
			},
			"mail": {
				"type": "tcp",
				"enabled": true,
				"localPort": 25
			},
			"smtp": {
				"type": "tcp",
				"enabled": true,
				"localPort": 465
			},
			"pop3": {
				"type": "tcp",
				"enabled": true,
				"localPort": 995
			},
			"imap": {
				"type": "tcp",
				"enabled": true,
				"localPort": 993
			}
		},
		"reverseProxy": [
			{
				"type": "http",
				"port": 7400,
				"path": "/"
			}
		],
		"services": [
			"frp"
		]
	}
}
