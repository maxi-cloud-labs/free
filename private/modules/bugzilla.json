{
	"module": "bugzilla",
	"name": "Bugzilla",
	"title": "Bug Tracking",
	"category": "Developer",
	"version": "5.3.3",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "SQLite",
	"github": "bugzilla/bugzilla",
	"description": "A web-based issue tracker for reporting bugs, managing defects, and coordinating software fixes.",
	"hero": "a giant monstrous lizard-like bug being hunted by a tiny glowing magnifying glass. kaiju-movie, retro, dramatic",
	"keywords": [
		"bug",
		"defect",
		"issue",
		"qa",
		"regression",
		"ticket",
		"tracking",
		"triage"
	],
	"proprietary": [
		"Jira",
		"Linear",
		"YouTrack"
	],
	"default": {
		"addLineInDirectory": "AddHandler cgi-script .cgi\n\t\tOptions +ExecCGI",
		"autoLogin": {
			"inject": [
				{
					"url": "/index.cgi",
					"form": "form[id=mini_login_top]",
					"arg1": "input[name=Bugzilla_login]",
					"arg2": "input[name=Bugzilla_password]",
					"arg3": "input[type=submit]",
					"val1": 0,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/index.cgi",
					"arg1": "username",
					"arg2": "password",
					"val1": 0,
					"val2": 2
				}
			]
		},
		"config": true,
		"enabled": true,
		"followSymLinks": true,
		"localPort": 9411,
		"permissions": [
			"user"
		],
		"reset": true,
		"setup": true,
		"setupDependencies": [],
		"setupRoot": true
	}
}