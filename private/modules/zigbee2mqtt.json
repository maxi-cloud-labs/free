{
	"module": "zigbee2mqtt",
	"name": "Zigbee2MQTT",
	"title": "Zigbee MQTT Bridge",
	"category": "Personal",
	"version": "2.5.1",
	"installMethod": "npm",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "SQLite",
	"github": "Koenkk/zigbee2mqtt",
	"description": "A Zigbee-to-MQTT bridge for connecting smart-home devices without proprietary hubs.",
	"hero": "a glowing bee-shaped zigbee hub linking tiny smart devices around a hive. industrious, cute, honeycomb network",
	"keywords": [
		"automation",
		"device",
		"iot",
		"pairing",
		"pubsub",
		"sensor",
		"smarthome",
		"wireless"
	],
	"proprietary": [
		"Aqara Hub",
		"Philips Hue Bridge",
		"Samsung SmartThings"
	],
	"default": {
		"enabled": true,
		"localPort": 9604,
		"permissions": [],
		"permissionsPublicForbidden": true,
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 8095,
				"path": "/"
			},
			{
				"type": "ws",
				"port": 8095,
				"path": "/api"
			}
		],
		"services": [
			"zigbee2mqtt"
		],
		"setup": true,
		"setupDependencies": []
	}
}
