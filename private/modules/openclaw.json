{
	"module": "openclaw",
	"name": "Open Claw",
	"title": "AI Assistant Engine",
	"category": "Personal",
	"version": "2026.2.6-3",
	"installMethod": "npm",
	"web": true,
	"essential": false,
	"finished": true,
	"ai": true,
	"database": "SQLite",
	"github": "openclaw/openclaw",
	"description": "A user-friendly personal AI assistant.",
	"keywords": [
		"AI assistant",
		"AI models",
		"LLMs",
		"Language",
		"Language model"
	],
	"proprietary": [],
	"default": {
		"addConfigBegin": "Header set Content-Security-Policy \"script-src 'self' 'unsafe-inline';\"",
		"autoLogin": {
			"inject": [
				{
					"url": "/",
					"form": "div[class=login-gate__form]",
					"arg1": "input[placeholder=\\\"OPENCLAW_GATEWAY_TOKEN (optional)\\\"]",
					"arg2": "",
					"arg3": "button[class~=login-gate__connect]",
					"val1": 2,
					"val2": 4
				}
			],
			"post": [
				{
					"url": "/",
					"arg1": "token",
					"arg2": "",
					"val1": 2,
					"val2": 4
				}
			]
		},
		"autoLoginNoGzip": [
			"^/$"
		],
		"config": true,
		"enabled": true,
		"localPort": 9481,
		"permissions": [],
		"permissionsPublicForbidden": true,
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 18789,
				"path": "/"
			},
			{
				"type": "ws",
				"port": 18789,
				"path": "/"
			}
		],
		"services": [
			"openclaw"
		],
		"setup": true,
		"setupDependencies": []
	}
}
