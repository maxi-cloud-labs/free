{
	"module": "librechat",
	"name": "LibreChat",
	"title": "Libre Chatbot",
	"category": "AI Generative",
	"version": "v0.7.9",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "MongoDB",
	"github": "LibreChat-AI/LibreChat",
	"description": "A self-hosted AI chat workspace with multiple language models, agents, and conversation tools.",
	"hero": "a friendly open-door chat window with many different glowing AI faces gathered inside. welcoming, freedom-themed, vibrant",
	"keywords": [
		"agent",
		"assistant",
		"chatbot",
		"conversation",
		"inference",
		"llm",
		"multimodel",
		"prompt"
	],
	"proprietary": [
		"ChatGPT",
		"Claude",
		"Google Gemini"
	],
	"default": {
		"autoLogin": {
			"inject": [
				{
					"url": "/",
					"form": "form[method=POST]",
					"arg1": "input[id=email]",
					"arg2": "input[id=password]",
					"arg3": "button[type=submit]",
					"val1": 1,
					"val2": 2
				},
				{
					"url": "/login",
					"form": "form[method=POST]",
					"arg1": "input[id=email]",
					"arg2": "input[id=password]",
					"arg3": "button[type=submit]",
					"val1": 1,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/api/auth/login",
					"arg1": "email",
					"arg2": "password",
					"val1": 1,
					"val2": 2
				}
			]
		},
		"autoLoginNoGzip": [
			"^/$",
			"^/login"
		],
		"config": true,
		"enabled": true,
		"localPort": 9481,
		"permissions": [
			"user"
		],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 3080,
				"path": "/"
			}
		],
		"services": [
			"librechat"
		],
		"setup": true,
		"setupDependencies": [
			"meilisearch",
			"redis",
			"mongodb"
		]
	}
}
