{
	"module": "cockpit",
	"name": "Cockpit",
	"title": "Server Health",
	"category": "Server",
	"version": "337",
	"installMethod": "apt",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "",
	"github": "cockpit-project/cockpit",
	"description": "A browser-based administration console for Linux servers, services, and system health.",
	"hero": "a cockpit dashboard with glowing gauges and a server-rack view out of the windshield. pilot's-eye view, adventure, calm control",
	"keywords": [
		"administration",
		"daemon",
		"dashboard",
		"linux",
		"monitoring",
		"networking",
		"storage",
		"sysadmin"
	],
	"proprietary": [
		"Plesk",
		"cPanel"
	],
	"default": {
		"addConfigBegin": "Alias /access /usr/local/modules/cockpit/access\n\t<Directory /usr/local/modules/cockpit/access>\n\t\tRequire all granted\n\t</Directory>\n\tProxyPass /access !",
		"enabled": true,
		"homepage": "/access",
		"localPort": 9423,
		"permissions": [],
		"permissionsPublicForbidden": true,
		"reservedToFirstUser": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 9090,
				"path": "/"
			},
			{
				"type": "ws",
				"port": 9090,
				"path": "/"
			}
		]
	}
}
