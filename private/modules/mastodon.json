{
	"module": "mastodon",
	"name": "Mastodon",
	"title": "Decentralized Social Network",
	"category": "Personal",
	"version": "",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "PostgreSQL",
	"github": "mastodon/mastodon",
	"description": "A federated social network for independent communities, short posts, and public conversations.",
	"hero": "a majestic woolly mastodon with glowing network lines in its tusks, marching in a herd across the horizon. epic, decentralized, mythic",
	"keywords": [
		"Communities",
		"Federation",
		"Fediverse",
		"Followers",
		"Microblogging",
		"Posting",
		"Social",
		"Timelines"
	],
	"proprietary": [
		"Bluesky",
		"Threads",
		"X"
	],
	"default": {
		"addConfigBegin": "Header set Content-Security-Policy \"script-src 'self' 'unsafe-inline';\"",
		"alias": [
			"social"
		],
		"autoLogin": {
			"inject": [
				{
					"url": "/auth/sign_in",
					"form": "form[id=new_user]",
					"arg1": "input[id=user_email]",
					"arg2": "input[id=user_password]",
					"arg3": "button[name=button]",
					"val1": 1,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/auth/sign_in",
					"arg1": "email",
					"arg2": "password",
					"val1": 1,
					"val2": 2
				}
			]
		},
		"config": true,
		"enabled": true,
		"localPort": 9469,
		"permissions": [
			"user"
		],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 8112,
				"path": "/"
			}
		],
		"services": [
			"mastodon",
			"mastodon-sidekiq"
		],
		"setup": true,
		"setupDependencies": [
			"postgresql"
		],
		"setupRoot": true
	}
}
