{
	"module": "swaggerui",
	"name": "Swagger UI",
	"title": "API Docs",
	"category": "Developer",
	"version": "5.31.2",
	"installMethod": "npm",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "",
	"github": "swagger-api/swagger-ui",
	"description": "An interactive API documentation viewer for exploring and testing OpenAPI endpoints.",
	"hero": "a glowing interactive API doc page with green and blue endpoint chips opening like a stage curtain. theatrical, clean, inviting",
	"keywords": [
		"documentation",
		"endpoint",
		"explorer",
		"interactive",
		"openapi",
		"request",
		"specification",
		"testing"
	],
	"proprietary": [
		"Postman",
		"ReadMe",
		"SwaggerHub"
	],
	"default": {
		"alias": [
			"apidocs"
		],
		"enabled": true,
		"followSymLinks": true,
		"localPort": 9537,
		"path": "/disk/admin/modules/swaggerui",
		"permissions": [
			"public"
		],
		"reset": true,
		"setup": true,
		"setupDependencies": []
	}
}
