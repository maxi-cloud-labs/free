{
	"module": "lobechat",
	"name": "Lobe Chat",
	"title": "Lobe Chatbot",
	"category": "AI Generative",
	"version": "v1.143.2",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "PostgreSQL",
	"github": "lobehub/lobehub",
	"description": "An AI agent workspace for chatting with models, managing assistants, and coordinating AI tasks.",
	"hero": "a modern glowing lobe-shaped chat bubble wearing a tiny crown, surrounded by agent avatars. sleek, premium, elegant",
	"keywords": [
		"agent",
		"assistant",
		"chatbot",
		"conversation",
		"llm",
		"orchestration",
		"prompt",
		"scheduling"
	],
	"proprietary": [
		"ChatGPT",
		"Claude",
		"Microsoft Copilot"
	],
	"default": {
		"config": true,
		"enabled": true,
		"localPort": 9490,
		"permissions": [
			"user"
		],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 3210,
				"path": "/"
			},
			{
				"type": "ws",
				"port": 3210,
				"path": "/"
			}
		],
		"setup": true,
		"setupDependencies": [
			"redis",
			"postgresql"
		],
		"setupRoot": true
	}
}
