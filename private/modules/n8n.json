{
	"module": "n8n",
	"name": "n8n",
	"title": "Workflow Automation",
	"category": "Collaboration",
	"version": "n8n@2.13.4",
	"installMethod": "npm",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "",
	"github": "n8n-io/n8n",
	"description": "A visual automation platform for connecting apps, orchestrating workflows, and building AI integrations.",
	"hero": "an octopus with eight glowing arms linking apps together into a workflow. clever, whimsical, multi-tasking",
	"keywords": [
		"agent",
		"automation",
		"integration",
		"node",
		"orchestration",
		"trigger",
		"webhook",
		"workflow"
	],
	"proprietary": [
		"Make",
		"Microsoft Power Automate",
		"Zapier"
	],
	"default": {
		"autoLogin": {
			"inject": [
				{
					"url": "/",
					"form": "main[id=content]",
					"arg1": "input[id=emailOrLdapLoginId]",
					"arg2": "input[id=password]",
					"arg3": "button[type=button]",
					"val1": 1,
					"val2": 2
				},
				{
					"url": "/signin",
					"form": "main[id=content]",
					"arg1": "input[id=emailOrLdapLoginId]",
					"arg2": "input[id=password]",
					"arg3": "button[type=button]",
					"val1": 1,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/rest/login",
					"arg1": "email",
					"arg2": "password",
					"val1": 1,
					"val2": 2
				}
			]
		},
		"autoLoginNoGzip": [
			"^/$",
			"^/signin"
		],
		"config": true,
		"enabled": true,
		"localPort": 9478,
		"permissions": [],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 5678,
				"path": "/"
			}
		],
		"services": [
			"n8n"
		],
		"setup": true,
		"setupDependencies": []
	}
}
