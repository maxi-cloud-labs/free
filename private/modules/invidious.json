{
	"module": "invidious",
	"name": "Invidious",
	"title": "Youtube With Privacy",
	"category": "Media",
	"version": "v2.20250913.0",
	"installMethod": "clone",
	"web": true,
	"recommended": true,
	"finished": true,
	"database": "PostgreSQL",
	"github": "iv-org/invidious",
	"description": "A privacy-focused alternative YouTube interface for browsing and watching videos with less tracking.",
	"hero": "an elegant masked figure watching a video screen from the shadows, a shield-shaped play button. stealthy, private, noir",
	"keywords": [
		"frontend",
		"playlist",
		"privacy",
		"streaming",
		"subscription",
		"tracking",
		"video",
		"youtube"
	],
	"proprietary": [
		"YouTube",
		"YouTube Premium"
	],
	"default": {
		"config": true,
		"enabled": true,
		"localPort": 9448,
		"permissions": [
			"user"
		],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 3000,
				"path": "/",
				"path2": "/ nocanon"
			}
		],
		"services": [
			"invidious-companion",
			"invidious"
		],
		"setup": true,
		"setupDependencies": [
			"deno",
			"postgresql"
		],
		"setupRoot": true
	}
}