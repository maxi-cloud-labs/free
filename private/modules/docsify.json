{
	"module": "docsify",
	"name": "docsify",
	"title": "Live Docs",
	"category": "Knowledge",
	"version": "v4.13.1",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "",
	"github": "docsifyjs/docsify",
	"description": "A documentation website generator with live rendering of Markdown files.",
	"hero": "a glowing open book that lights up pages in a living web document with an unfolding sidebar. magical, scholarly, light and airy",
	"keywords": [
		"documentation",
		"guide",
		"markdown",
		"navigation",
		"publishing",
		"rendering",
		"sidebar",
		"website"
	],
	"proprietary": [
		"GitBook",
		"Mintlify"
	],
	"default": {
		"alias": [
			"docs"
		],
		"enabled": true,
		"followSymLinks": true,
		"localPort": 9434,
		"path": "/disk/admin/modules/docsify",
		"permissions": [
			"public"
		],
		"reset": true,
		"setup": true,
		"setupDependencies": []
	}
}
