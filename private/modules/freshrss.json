{
	"module": "freshrss",
	"name": "FreshRSS",
	"title": "RSS Feed",
	"category": "Personal",
	"version": "1.26.3",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": false,
	"database": "",
	"github": "FreshRSS/FreshRSS",
	"description": "A self-hosted RSS reader for following news feeds, blogs, and website updates.",
	"hero": "a fresh stream of glowing RSS feed icons flowing from a drinking glass of orange juice. refreshing, summery, lively",
	"keywords": [
		"aggregation",
		"article",
		"atom",
		"feed",
		"headline",
		"opml",
		"reading",
		"subscription"
	],
	"proprietary": [
		"Feedly",
		"Inoreader"
	],
	"default": {
		"addLineInDirectory": "AllowOverride AuthConfig FileInfo Indexes Limit",
		"alias": [
			"rss"
		],
		"enabled": true,
		"localPort": 9439,
		"path": "/usr/local/modules/freshrss/p",
		"permissions": [
			"user"
		]
	}
}