{
	"module": "newapi",
	"name": "New API",
	"title": "AI Model Hub",
	"category": "AI",
	"version": "v0.11.0-alpha.9",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "SQLite",
	"github": "QuantumNous/new-api",
	"description": "A centralized AI model gateway for routing and translating requests across different LLM providers.",
	"hero": "a grand central hub with glowing portal gates, each leading to a different AI model. sci-fi hub, welcoming, majestic",
	"keywords": [
		"Aggregation",
		"Billing",
		"Compatibility",
		"Gateway",
		"Llm",
		"Providers",
		"Routing",
		"Tokens"
	],
	"proprietary": [
		"Cloudflare AI Gateway",
		"OpenRouter",
		"Vercel AI Gateway"
	],
	"default": {
		"autoLogin": {
			"inject": [
				{
					"url": "/",
					"form": "form",
					"arg1": "input[id=username]",
					"arg2": "input[id=password]",
					"arg3": "button[type=submit]",
					"val1": 0,
					"val2": 2
				},
				{
					"url": "/login",
					"form": "form",
					"arg1": "input[id=username]",
					"arg2": "input[id=password]",
					"arg3": "button[type=submit]",
					"val1": 0,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/api/user/login",
					"arg1": "username",
					"arg2": "password",
					"val1": 0,
					"val2": 2
				}
			]
		},
		"autoLoginNoGzip": [
			"^/$",
			"^/login"
		],
		"config": true,
		"enabled": true,
		"localPort": 9479,
		"permissions": [
			"user"
		],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 8118,
				"path": "/"
			}
		],
		"services": [
			"newapi"
		],
		"setup": true,
		"setupDependencies": []
	}
}
