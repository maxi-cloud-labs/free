{
	"module": "litellm",
	"name": "LiteLLM",
	"title": "AI Proxy",
	"category": "AI Generative",
	"version": "1.81.15",
	"installMethod": "pip",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "PostgreSQL",
	"github": "BerriAI/litellm",
	"description": "A unified LLM API gateway for routing model requests, monitoring costs, and applying guardrails.",
	"hero": "a lightweight feather channeling a hundred glowing LLM streams into a single beam. weightless, universal, converging",
	"keywords": [
		"compatibility",
		"gateway",
		"inference",
		"loadbalancing",
		"provider",
		"quota",
		"routing",
		"token"
	],
	"proprietary": [
		"Cloudflare AI Gateway",
		"OpenRouter",
		"Vercel AI Gateway"
	],
	"default": {
		"autoLogin": {
			"inject": [
				{
					"url": "/ui/login/",
					"form": "form",
					"arg1": "input[id=username]",
					"arg2": "input[id=password]",
					"arg3": "button[type=submit]",
					"val1": 0,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/v2/login",
					"arg1": "username",
					"arg2": "password",
					"val1": 0,
					"val2": 2
				}
			]
		},
		"config": true,
		"enabled": true,
		"homepage": "/ui",
		"localPort": 9463,
		"permissions": [
			"user"
		],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 4001,
				"path": "/"
			}
		],
		"services": [
			"litellm"
		],
		"setup": true,
		"setupDependencies": [
			"postgresql"
		],
		"setupRoot": true
	}
}
