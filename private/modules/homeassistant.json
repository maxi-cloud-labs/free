{
	"module": "homeassistant",
	"name": "Home Assistant",
	"title": "Home Automation",
	"category": "Personal",
	"version": "2025.10.3",
	"installMethod": "pip",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "SQLite",
	"github": "home-assistant/core",
	"description": "A private home automation hub for controlling smart devices, routines, and connected sensors.",
	"hero": "a glowing house with all its smart devices connected by light threads, a small heart-shaped hub in the center. warm, cozy, futuristic home",
	"keywords": [
		"automation",
		"dashboard",
		"device",
		"integration",
		"iot",
		"routine",
		"sensor",
		"smarthome"
	],
	"proprietary": [
		"Apple Home",
		"Google Home",
		"Samsung SmartThings"
	],
	"default": {
		"alias": [
			"home"
		],
		"autoLogin": {
			"inject": [
				{
					"url": "/",
					"form": "form",
					"arg1": "input[name=username]",
					"arg2": "input[name=password]",
					"arg3": "ha-button",
					"val1": 0,
					"val2": 2
				},
				{
					"url": "/auth/authorize",
					"form": "form",
					"arg1": "input[name=username]",
					"arg2": "input[name=password]",
					"arg3": "ha-button",
					"val1": 0,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/auth/login_flow*",
					"arg1": "username",
					"arg2": "password",
					"val1": 0,
					"val2": 2
				}
			]
		},
		"autoLoginNoGzip": [
			"^/$",
			"^/auth/authorize"
		],
		"config": true,
		"enabled": true,
		"localPort": 9444,
		"permissions": [
			"user"
		],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 8123,
				"path": "/"
			},
			{
				"type": "ws",
				"port": 8123,
				"path": "/api/websocket"
			}
		],
		"services": [
			"homeassistant"
		],
		"setup": true,
		"setupDependencies": [
			"zigbee2mqtt"
		]
	}
}