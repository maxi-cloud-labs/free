{
	"module": "webtrees",
	"name": "webtrees",
	"title": "Genealogy",
	"category": "Personal",
	"version": "2.1.25",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "MySQL",
	"github": "fisharebest/webtrees",
	"description": "An online genealogy platform for organizing family trees, relatives, and historical records.",
	"hero": "a sprawling ancestral family tree with glowing portraits as leaves and roots deep in the earth. timeless, genealogical, cinematic sepia",
	"keywords": [
		"ancestor",
		"ancestry",
		"familytree",
		"gedcom",
		"genealogy",
		"heritage",
		"lineage",
		"relative"
	],
	"proprietary": [
		"Ancestry",
		"Findmypast",
		"MyHeritage"
	],
	"default": {
		"autoLogin": {
			"inject": [
				{
					"url": "/index.php",
					"form": "form[class=\\\"wt-page-options wt-page-options-login\\\"]",
					"arg1": "input[name=username]",
					"arg2": "input[name=password]",
					"arg3": "button[type=submit]",
					"val1": 0,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/index.php",
					"arg1": "username",
					"arg2": "password",
					"val1": 0,
					"val2": 2
				}
			]
		},
		"autoLoginNoGzip": [
			"^/index.php"
		],
		"config": true,
		"enabled": true,
		"localPort": 9550,
		"permissions": [
			"user"
		],
		"reset": true,
		"setup": true,
		"setupDependencies": [
			"mysql"
		],
		"setupRoot": true
	}
}
