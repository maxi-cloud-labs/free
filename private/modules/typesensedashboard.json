{
	"module": "typesensedashboard",
	"name": "Typesense Dashboard",
	"title": "Search API Viewer",
	"category": "Database",
	"version": "v2.4.1",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "",
	"github": "bfritscher/typesense-dashboard",
	"description": "A web dashboard for browsing, searching, and administering Typesense collections.",
	"hero": "a control panel dashboard of a typewriter-hybrid with glowing search indexes as dials. retro-futuristic, gauges, clean",
	"keywords": [
		"Administration",
		"Collections",
		"Documents",
		"Indexing",
		"Inspection",
		"Queries",
		"Schemas",
		"Searching"
	],
	"proprietary": [
		"Algolia Dashboard",
		"Elastic Cloud Console"
	],
	"default": {
		"enabled": true,
		"followSymLinks": true,
		"localPort": 9545,
		"permissions": [
			"user"
		],
		"reverseProxy": [
			{
				"type": "http",
				"port": 8108,
				"path": "/api",
				"path2": "/"
			}
		],
		"setupDependencies": [
			"typesense"
		]
	}
}
