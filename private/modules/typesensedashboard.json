{
	"module": "typesensedashboard",
	"name": "Typesense Dashboard",
	"title": "Search API Viewer",
	"category": "Knowledge",
	"version": "v2.4.1",
	"installMethod": "clone",
	"web": true,
	"essential": false,
	"finished": true,
	"database": "",
	"github": "bfritscher/typesense-dashboard",
	"description": "A tool to view Typesense.",
	"hero": "a control panel dashboard of a typewriter-hybrid with glowing search indexes as dials. retro-futuristic, gauges, clean",
	"keywords": [
		"API",
		"Cloud service",
		"Documentation",
		"Engine",
		"Fast search",
		"Search",
		"Search engine",
		"Search tool",
		"Typo tolerance",
		"Viewer"
	],
	"proprietary": [],
	"default": {
		"enabled": true,
		"followSymLinks": true,
		"localPort": 9545,
		"permissions": [
			"user"
		],
		"reverseProxy": [
			{
				"type": "http",
				"port": 8108,
				"path": "/api",
				"path2": "/"
			}
		],
		"setupDependencies": [
			"typesense"
		]
	}
}
