{
	"module": "metube",
	"name": "MeTube",
	"title": "YouTube Videos",
	"category": "Media",
	"version": "HEAD",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "SQLite",
	"github": "alexta69/metube",
	"description": "A browser-based video downloader for YouTube and other sites, including playlists.",
	"hero": "a retro TV screen with a glowing download arrow pulling video from the clouds into a cozy shelf. nostalgic, playful, homemade",
	"keywords": [
		"archiving",
		"audio",
		"browser",
		"download",
		"playlist",
		"video",
		"youtube",
		"yt-dlp"
	],
	"proprietary": [
		"4K Video Downloader Plus",
		"Internet Download Manager"
	],
	"default": {
		"enabled": true,
		"localPort": 9473,
		"permissions": [
			"user"
		],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 8089,
				"path": "/"
			},
			{
				"type": "ws",
				"port": 8089,
				"path": "/socket.io"
			}
		],
		"services": [
			"metube"
		],
		"setup": true,
		"setupDependencies": []
	}
}
