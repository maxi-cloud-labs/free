{
	"module": "jellyfin",
	"name": "Jellyfin",
	"title": "Media Streaming",
	"category": "Media",
	"version": "v10.10.7",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "SQLite",
	"github": "jellyfin/jellyfin",
	"description": "A personal media server for organizing and streaming movies, TV shows, music, and photos.",
	"hero": "a bioluminescent jellyfish glowing in the deep ocean, a movie reel inside its translucent bell. dreamy, cinematic, mesmerizing",
	"keywords": [
		"library",
		"movie",
		"music",
		"playback",
		"playlist",
		"streaming",
		"television",
		"transcoding"
	],
	"proprietary": [
		"Emby",
		"Plex"
	],
	"default": {
		"autoLogin": {
			"inject": [
				{
					"url": "/web/",
					"form": "form[class*=manualLoginForm]",
					"arg1": "input[id=txtManualName]",
					"arg2": "input[id=txtManualPassword]",
					"arg3": "button[type=submit]",
					"val1": 0,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/Users/authenticatebyname",
					"arg1": "username",
					"arg2": "password",
					"val1": 0,
					"val2": 2
				}
			]
		},
		"autoLoginNoGzip": [
			"^/web/$"
		],
		"config": true,
		"enabled": true,
		"localPort": 9451,
		"permissions": [
			"user"
		],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 8096,
				"path": "/"
			}
		],
		"services": [
			"jellyfin"
		],
		"setup": true,
		"setupDependencies": [],
		"setupRoot": true
	}
}