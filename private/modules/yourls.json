{
	"module": "yourls",
	"name": "YOURLS",
	"title": "URL Shortener",
	"category": "Collaboration",
	"version": "1.10.2",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "MySQL",
	"github": "YOURLS/YOURLS",
	"description": "A self-hosted URL shortening service with custom links, click statistics, and link management.",
	"hero": "a long snaking link being cut and shortened by giant scissors, sparks flying. dramatic, snappy, comic",
	"keywords": [
		"Analytics",
		"Clicktracking",
		"Customurls",
		"Links",
		"Qr",
		"Redirects",
		"Shortener",
		"Statistics"
	],
	"proprietary": [
		"Bitly",
		"Rebrandly",
		"TinyURL"
	],
	"default": {
		"addLineInDirectory": "RewriteBase /\n\t\tRewriteCond %{REQUEST_FILENAME} !-f\n\t\tRewriteCond %{REQUEST_FILENAME} !-d\n\t\tRewriteRule ^.*$ /yourls-loader.php [L]",
		"autoLogin": {
			"inject": [
				{
					"url": "/admin/index.php",
					"form": "form[method=post]",
					"arg1": "input[name=username]",
					"arg2": "input[name=password]",
					"arg3": "input[type=submit]",
					"val1": 0,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/admin/index.php",
					"arg1": "username",
					"arg2": "password",
					"val1": 0,
					"val2": 2
				}
			]
		},
		"config": true,
		"enabled": true,
		"homepage": "/admin",
		"localPort": 9556,
		"permissions": [
			"hardware",
			"user"
		],
		"reset": true,
		"setup": true,
		"setupDependencies": [
			"mysql"
		]
	}
}
