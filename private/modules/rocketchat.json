{
	"module": "rocketchat",
	"name": "Rocket.Chat",
	"title": "Communication",
	"category": "Collaboration",
	"version": "8.1.0",
	"installMethod": "wget",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "",
	"github": "RocketChat/Rocket.Chat",
	"description": "A secure workplace messaging platform for team chat, collaboration, and customer conversations.",
	"hero": "a sleek rocket made of speech bubbles launching from a chat window into orbit. exuberant, space-race, optimistic",
	"keywords": [
		"channel",
		"collaboration",
		"conversation",
		"inbox",
		"messaging",
		"notification",
		"support",
		"team"
	],
	"proprietary": [
		"Google Chat",
		"Microsoft Teams",
		"Slack"
	],
	"default": {
		"enabled": true,
		"localPort": 9562,
		"permissions": [
			"user"
		],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 3100,
				"path": "/"
			}
		],
		"services": [
			"rocketchat"
		],
		"setup": true,
		"setupDependencies": []
	}
}
