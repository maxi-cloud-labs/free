{
	"module": "piped",
	"name": "Piped",
	"title": "Ad-Free YouTube Frontend",
	"category": "Media",
	"version": "1c3cfd23",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "PostgreSQL",
	"github": "TeamPiped/Piped",
	"description": "An alternative YouTube frontend for privacy-conscious video browsing and ad-free playback.",
	"hero": "a bagpiper-like pipe organ shooting glowing play-button notes without ads, clear skies. musical, free, breezy",
	"keywords": [
		"adblocking",
		"playlist",
		"privacy",
		"streaming",
		"subscription",
		"tracking",
		"video",
		"youtube"
	],
	"proprietary": [
		"YouTube Premium"
	],
	"default": {
		"config": true,
		"enabled": true,
		"localPort": 9542,
		"path": "/usr/local/modules/piped/dist",
		"permissions": [
			"user"
		],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 8102,
				"path": "/_api_/",
				"path2": "/"
			},
			{
				"type": "http",
				"port": 8103,
				"path": "/_proxy_/",
				"path2": "/"
			},
			{
				"type": "http",
				"port": 8103,
				"path": "/api/"
			}
		],
		"services": [
			"pipedbackend",
			"pipedproxy"
		],
		"setup": true,
		"setupDependencies": [
			"java",
			"postgresql"
		],
		"setupRoot": true
	}
}
