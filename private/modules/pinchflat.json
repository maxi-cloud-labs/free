{
	"module": "pinchflat",
	"name": "Pinchflat",
	"title": "YouTube Channels",
	"category": "Media",
	"version": "v2025.9.26",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "SQLite",
	"github": "kieraneglin/pinchflat",
	"description": "An automated YouTube channel and playlist downloader for maintaining a local media library.",
	"hero": "a delicate pair of fingers pinching a glowing video frame from a stream, pulling into a local shelf. tactile, careful, collector",
	"keywords": [
		"archiving",
		"channel",
		"downloading",
		"metadata",
		"playlist",
		"subscription",
		"synchronization",
		"youtube"
	],
	"proprietary": [
		"4K Video Downloader Plus"
	],
	"default": {
		"enabled": true,
		"localPort": 9540,
		"permissions": [
			"user"
		],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 4000,
				"path": "/"
			},
			{
				"type": "ws",
				"port": 4000,
				"path": "/"
			}
		],
		"services": [
			"pinchflat"
		],
		"setup": true,
		"setupDependencies": []
	}
}
