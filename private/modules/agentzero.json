{
	"module": "agentzero",
	"name": "Agent Zero",
	"title": "AI Agent",
	"category": "AI Agentic",
	"version": "2.1.25",
	"installMethod": "clone",
	"web": true,
	"recommended": true,
	"finished": true,
	"database": "",
	"github": "agent0ai/agent-zero",
	"description": "An autonomous AI agent framework for task execution, tool use, and multi-step workflows.",
	"hero": "a lone robot agent made of a single glowing zero ring, standing in a vast empty void. minimalist, mysterious, origin-story",
	"keywords": [
		"agent",
		"autonomous",
		"delegation",
		"execution",
		"planning",
		"reasoning",
		"toolcalling",
		"workflow"
	],
	"proprietary": [
		"ChatGPT",
		"Microsoft Copilot Studio",
		"Salesforce Agentforce"
	],
	"default": {
		"autoLogin": {
			"inject": [
				{
					"url": "/login",
					"form": "form[class=\\\"login-form\\\"]",
					"arg1": "input[id=username]",
					"arg2": "input[id=password]",
					"arg3": "button[type=submit]",
					"val1": 0,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/login",
					"arg1": "username",
					"arg2": "password",
					"val1": 0,
					"val2": 2
				}
			]
		},
		"config": true,
		"enabled": true,
		"localPort": 9408,
		"permissions": [
			"user"
		],
		"reset": true,
		"setup": true,
		"setupDependencies": [
			"docker"
		],
		"setupRoot": true
	}
}
