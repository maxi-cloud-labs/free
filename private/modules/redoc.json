{
	"module": "redoc",
	"name": "Redoc",
	"title": "API Docs Renderer",
	"category": "Knowledge",
	"version": "2.5.2",
	"installMethod": "npm",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "",
