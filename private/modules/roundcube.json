{
	"module": "roundcube",
	"name": "Roundcube",
	"title": "Webmail",
	"category": "Personal",
	"version": "1.6.11",
	"installMethod": "apt",
	"web": true,
	"recommended": true,
	"finished": true,
	"database": "SQLite",
	"github": "roundcube/roundcubemail",
	"description": "A browser-based email client for reading, composing, and organizing IMAP mailboxes.",
	"hero": "a glowing cube-shaped letterbox opening to reveal an email, sunlit window behind. gentle, domestic, clean",
	"keywords": [
		"Attachments",
		"Composing",
		"Contacts",
		"Folders",
		"Imap",
		"Inbox",
		"Messages",
		"Webmail"
	],
	"proprietary": [
		"Gmail",
		"Outlook on the web",
		"Yahoo Mail"
	],
	"default": {
		"alias": [
			"webmail"
		],
		"autoLogin": {
			"inject": [
				{
					"url": "/index.php",
					"form": "form[id=login-form]",
					"arg1": "input[name=_user]",
					"arg2": "input[name=_pass]",
					"arg3": "button[type=submit]",
					"val1": 1,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/index.php",
					"arg1": "email",
					"arg2": "password",
					"val1": 1,
					"val2": 2
				}
			]
		},
		"config": true,
		"enabled": true,
		"localPort": 9523,
		"path": "/usr/share/roundcube",
		"permissions": [
			"user"
		],
		"reset": true,
		"setup": true,
		"setupDependencies": [
			"postfix"
		],
		"setupPriority": true
	}
}
