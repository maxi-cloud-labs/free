{
	"module": "microbin",
	"name": "MicroBin",
	"title": "Simple Pastebin",
	"category": "Utils",
	"version": "v2.0.4",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "",
	"github": "szabodanika/microbin",
	"description": "A lightweight pastebin for sharing text snippets, files, and short links privately.",
	"hero": "a tiny glowing paste jar with a single note inside floating in a dark void. minimalist, tiny, mysterious",
	"keywords": [
		"expiration",
		"link",
		"pastebin",
		"privacy",
		"secret",
		"sharing",
		"snippet",
		"upload"
	],
	"proprietary": [
		"Pastebin.com"
	],
	"default": {
		"enabled": true,
		"localPort": 9502,
		"permissions": [
			"user"
		],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 8106,
				"path": "/"
			}
		],
		"services": [
			"microbin"
		],
		"setup": true,
		"setupDependencies": []
	}
}
