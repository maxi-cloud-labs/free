{
	"module": "syncthing",
	"name": "Syncthing",
	"title": "File Sync",
	"category": "Utils",
	"version": "2.0.13",
	"installMethod": "wget",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "SQLite",
	"github": "syncthing/syncthing",
	"description": "A private peer-to-peer file synchronization service for keeping folders consistent across devices.",
	"hero": "two glowing devices linked by a synchronized loop of light, sync arrows circling endlessly. harmony, cyclical, calm",
	"keywords": [
		"continuou",
		"device",
		"encrypted",
		"folder",
		"p2p",
		"replication",
		"synchronization",
		"transfer"
	],
	"proprietary": [
		"Dropbox",
		"Google Drive",
		"OneDrive"
	],
	"default": {
		"addConfigBegin": "RequestHeader set Host localhost",
		"enabled": true,
		"localPort": 9538,
		"permissions": [],
		"permissionsPublicForbidden": true,
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 8384,
				"path": "/"
			}
		],
		"services": [
			"syncthing"
		],
		"setup": true,
		"setupDependencies": []
	}
}
