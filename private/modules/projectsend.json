{
	"module": "projectsend",
	"name": "ProjectSend",
	"title": "File Sharing",
	"category": "Collaboration",
	"version": "r1720",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "MySQL",
	"github": "projectsend/projectsend",
	"description": "A private client file portal for uploading, organizing, and distributing shared documents.",
	"hero": "a courier handing a locked briefcase of files to a client in a modern office. professional, discreet, tidy",
	"keywords": [
		"client",
		"distribution",
		"download",
		"file",
		"permission",
		"sharing",
		"transfer",
		"upload"
	],
	"proprietary": [
		"Box",
		"Dropbox",
		"WeTransfer"
	],
	"default": {
		"autoLogin": {
			"inject": [
				{
					"url": "/index.php",
					"form": "form[id=login_form]",
					"arg1": "input[name=username]",
					"arg2": "input[name=password]",
					"arg3": "button[type=submit]",
					"val1": 0,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/index.php",
					"arg1": "username",
					"arg2": "password",
					"val1": 0,
					"val2": 2
				}
			]
		},
		"config": true,
		"enabled": true,
		"followSymLinks": true,
		"localPort": 9549,
		"permissions": [
			"user"
		],
		"reset": true,
		"setup": true,
		"setupDependencies": [
			"mysql"
		],
		"setupRoot": true
	}
}
