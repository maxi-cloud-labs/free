{
	"module": "ollama",
	"name": "Ollama",
	"title": "Local LLM Runtime",
	"category": "AI Generative",
	"version": "0.40.17",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "",
	"github": "ollama/ollama",
	"description": "A local AI model runtime for downloading, serving, and chatting with large language models.",
	"hero": "a friendly llama sitting in a cozy laptop glow, a speech bubble with tiny neural lights. gentle, warm, local-hero mascot",
	"keywords": [
		"chatbot",
		"embedding",
		"inference",
		"llm",
		"model",
		"offline",
		"prompt",
		"quantization"
	],
	"proprietary": [
		"LM Studio",
		"NVIDIA NIM"
	],
	"default": {
		"cmds": [
			"/usr/local/modules2/ollama/ollama"
		],
		"containerID": 1,
		"containerRun": "OLLAMA_HOST=0.0.0.0:11434 /usr/local/modules/ollama/ollama serve",
		"enabled": true,
		"localPort": 9514,
		"permissions": [],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 11434,
				"path": "/"
			}
		],
		"services": [
			"ollama"
		],
		"setup": true,
		"setupDependencies": [],
		"setupRoot": true
	}
}
