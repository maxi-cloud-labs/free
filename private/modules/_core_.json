{
	"module": "_core_",
	"name": "_Core_",
	"title": "Cloud App",
	"category": "Server",
	"version": "2025-11-11",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "",
	"github": "maxi-cloud-labs/free",
	"description": "A central dashboard for configuring and managing your personal cloud and self-hosted applications.",
	"hero": "a tiny glowing cloud floating above a Raspberry Pi board like a captured star, tethered by a thin light beam. heroic, intimate, sovereign",
	"keywords": [
		"administration",
		"configuration",
		"dashboard",
		"hosting",
		"infrastructure",
		"orchestration",
		"provisioning",
		"sovereignty"
	],
	"proprietary": [
		"Cloudron",
		"Umbrel"
	],
	"default": {
		"addLineInDirectory": "RewriteBase /\n\t\tRewriteRule ^index\\.html$ - [L]\n\t\tRewriteCond %{REQUEST_FILENAME} !-f\n\t\tRewriteCond %{REQUEST_FILENAME} !-d\n\t\tRewriteRule . /index.html [L]",
		"alias": [
			"app"
		],
		"enabled": true,
		"enabledUnalterable": true,
		"localPort": 9400,
		"path": "/usr/local/modules/_core_/web",
		"permissions": [
			"user"
		],
		"reverseProxy": [
			{
				"type": "ws",
				"port": 8094,
				"path": "/ws"
			}
		],
		"services": [
			"hardware-app",
			"hardware-init",
			"hardware-otg"
		]
	}
}
