{
	"module": "searxng",
	"name": "SearXNG",
	"title": "Search With Privacy",
	"category": "Personal",
	"version": "74ec225a",
	"installMethod": "clone",
	"web": true,
	"recommended": true,
	"finished": true,
	"database": "",
	"github": "searxng/searxng",
	"description": "A privacy-focused metasearch engine for combining results from multiple search providers.",
	"hero": "a hooded detective with a giant magnifier meta-searching glowing orbs from many search engines. privacy-noir, curious, shadowy",
	"keywords": [
		"Aggregation",
		"Anonymity",
		"Engines",
		"Metasearch",
		"Privacy",
		"Queries",
		"Search",
		"Tracking"
	],
	"proprietary": [
		"Bing",
		"Brave Search",
		"Google Search"
	],
	"default": {
		"alias": [
			"search"
		],
		"enabled": true,
		"localPort": 9525,
		"permissions": [
			"user"
		],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 8111,
				"path": "/"
			}
		],
		"services": [
			"searxng"
		],
		"setup": true,
		"setupDependencies": []
	}
}
