{
	"module": "osticket",
	"name": "osTicket",
	"title": "Support Ticket",
	"category": "Productivity",
	"version": "v1.18.2",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "MySQL",
	"github": "osTicket/osTicket",
	"description": "A help desk ticketing system for organizing customer requests and support conversations.",
	"hero": "a vintage ticket stub of glowing light, support agents stamping and routing them at a busy counter. retro, bustling, orderly",
	"keywords": [
		"Customers",
		"Escalations",
		"Helpdesk",
		"Queues",
		"Replies",
		"Requests",
		"Support",
		"Tickets"
	],
	"proprietary": [
		"Freshdesk",
		"Jira Service Management",
		"Zendesk"
	],
	"default": {
		"alias": [
			"helpdesk",
			"support"
		],
		"autoLogin": {
			"inject": [
				{
					"url": "/scp/login.php",
					"form": "form[id=login]",
					"arg1": "input[name=userid]",
					"arg2": "input[name=passwd]",
					"arg3": "button[type=submit]",
					"val1": 0,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/scp/login.php",
					"arg1": "username",
					"arg2": "password",
					"val1": 0,
					"val2": 2
				}
			]
		},
		"config": true,
		"enabled": true,
		"followSymLinks": true,
		"localPort": 9491,
		"permissions": [
			"user"
		],
		"reset": true,
		"setup": true,
		"setupDependencies": [
			"mysql"
		]
	}
}
