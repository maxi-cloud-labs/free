{
	"module": "portkey",
	"name": "Portkey",
	"title": "AI Gateway",
	"category": "AI Generative",
	"version": "1.15.2",
	"installMethod": "npm",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "",
	"github": "portkey-ai/gateway",
	"description": "An AI gateway for accessing multiple LLMs through one API with routing and safety controls.",
	"hero": "a magical glowing key-shaped portal transporting AI model rays through a gateway. wizardly, fast, shield-guarded",
	"keywords": [
		"gateway",
		"guardrail",
		"inference",
		"llm",
		"observability",
		"provider",
		"ratelimit",
		"routing"
	],
	"proprietary": [
		"Cloudflare AI Gateway",
		"OpenRouter",
		"Vercel AI Gateway"
	],
	"default": {
		"enabled": true,
		"homepage": "/public",
		"localPort": 9508,
		"permissions": [
			"user"
		],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 8787,
				"path": "/"
			}
		],
		"services": [
			"portkey"
		],
		"setup": true,
		"setupDependencies": []
	}
}