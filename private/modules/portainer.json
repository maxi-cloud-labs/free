{
	"module": "portainer",
	"name": "Portainer",
	"title": "Container Management",
	"category": "Server",
	"version": "2.33.6",
	"installMethod": "wget",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "BoltDB",
	"github": "portainer/portainer",
	"description": "A graphical management console for deploying and administering Docker and Kubernetes containers.",
	"hero": "a harbor crane lifting glowing containers over a port at dusk. industrial, ordered, cinematic",
	"keywords": [
		"administration",
		"container",
		"dashboard",
		"deployment",
		"docker",
		"kubernetes",
		"orchestration",
		"stack"
	],
	"proprietary": [
		"Docker Desktop",
		"Rancher Prime",
		"Red Hat OpenShift"
	],
	"default": {
		"addConfigBegin": "Header set Content-Security-Policy \"script-src 'self' 'unsafe-inline';\"",
		"autoLogin": {
			"inject": [
				{
					"url": "/",
					"form": "form",
					"arg1": "input[id=username]",
					"arg2": "input[id=password]",
					"arg3": "button[type=submit]",
					"val1": 0,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/api/auth",
					"arg1": "username",
					"arg2": "password",
					"val1": 0,
					"val2": 2
				}
			]
		},
		"autoLoginNoGzip": [
			"^/$"
		],
		"config": true,
		"enabled": true,
		"localPort": 9507,
		"permissions": [],
		"permissionsPublicForbidden": true,
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 8115,
				"path": "/"
			},
			{
				"type": "ws",
				"port": 8115,
				"path": "/"
			}
		],
		"services": [
			"portainer"
		],
		"setup": true,
		"setupDependencies": []
	}
}
