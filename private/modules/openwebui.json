{
	"module": "openwebui",
	"name": "Open WebUI",
	"title": "Chatbot",
	"category": "AI Generative",
	"version": "v0.6.41",
	"installMethod": "pip",
	"web": true,
	"recommended": true,
	"finished": true,
	"database": "SQLite",
	"github": "open-webui/open-webui",
	"description": "A self-hosted conversational AI interface for local and cloud-based language models.",
	"hero": "a glowing open window revealing a vivid AI conversation, curtains drifting in a breeze. airy, welcoming, user-friendly",
	"keywords": [
		"assistant",
		"chatbot",
		"conversation",
		"llm",
		"multimodel",
		"ollama",
		"prompt",
		"rag"
	],
	"proprietary": [
		"ChatGPT",
		"Claude",
		"Google Gemini"
	],
	"default": {
		"autoLogin": {
			"inject": [
				{
					"url": "/",
					"form": "form",
					"arg1": "input[id=email]",
					"arg2": "input[id=password]",
					"arg3": "button[type=submit]",
					"val1": 1,
					"val2": 2
				},
				{
					"url": "/auth",
					"form": "form",
					"arg1": "input[id=email]",
					"arg2": "input[id=password]",
					"arg3": "button[type=submit]",
					"val1": 1,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/api/v1/auths/signin",
					"arg1": "email",
					"arg2": "password",
					"val1": 1,
					"val2": 2
				}
			]
		},
		"autoLoginNoGzip": [
			"^/$",
			"^/auth"
		],
		"config": true,
		"enabled": true,
		"localPort": 9490,
		"permissions": [
			"user"
		],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 8101,
				"path": "/"
			},
			{
				"type": "ws",
				"port": 8101,
				"path": "/"
			}
		],
		"services": [
			"openwebui"
		],
		"setup": true,
		"setupDependencies": []
	}
}
