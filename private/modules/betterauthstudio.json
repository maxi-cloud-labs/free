{
	"module": "betterauthstudio",
	"name": "Better Auth Studio",
	"title": "Identity Management",
	"category": "Server",
	"version": "1.0.25",
	"installMethod": "npm",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "SQLite",
	"github": "Kinfe123/better-auth-studio",
	"description": "A graphical management interface for Better Auth users, sessions, and authentication settings.",
	"hero": "a control-room operator at a console, glowing identity badges floating above like holograms. studio lighting, command-center, sleek",
	"keywords": [
		"access",
		"account",
		"administration",
		"dashboard",
		"identity",
		"role",
		"session",
		"user"
	],
	"proprietary": [
		"Auth0 Dashboard",
		"Clerk Dashboard",
		"Firebase Console"
	],
	"default": {
		"alias": [
			"identities",
			"identity"
		],
		"enabled": true,
		"localPort": 9419,
		"permissions": [],
		"permissionsPublicForbidden": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 3002,
				"path": "/"
			}
		],
		"services": [
			"betterauth-studio"
		]
	}
}
