{
	"module": "openobserve",
	"name": "OpenObserve",
	"title": "Observability Tool",
	"category": "Server",
	"version": "v0.50.3",
	"installMethod": "wget",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "SQLite",
	"github": "openobserve/openobserve",
	"description": "An observability dashboard for analyzing logs, metrics, traces, and application performance.",
	"hero": "a giant all-seeing telescope observing a galaxy of logs, metrics and traces, petabyte-scale starfield. cosmic, vast, calm",
	"keywords": [
		"dashboard",
		"log",
		"metric",
		"monitoring",
		"observability",
		"pipeline",
		"telemetry",
		"trace"
	],
	"proprietary": [
		"Datadog",
		"New Relic",
		"Splunk"
	],
	"default": {
		"autoLogin": {
			"inject": [
				{
					"url": "/web/login",
					"form": "form",
					"arg1": "input[type=email]",
					"arg2": "input[type=password]",
					"arg3": "button[type=submit]",
					"val1": 1,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/auth/login",
					"arg1": "email",
					"arg2": "password",
					"val1": 1,
					"val2": 2
				}
			]
		},
		"autoLoginNoGzip": [
			"^/web/login"
		],
		"config": true,
		"enabled": true,
		"localPort": 9521,
		"permissions": [],
		"permissionsPublicForbidden": true,
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 5080,
				"path": "/"
			}
		],
		"services": [
			"openobserve"
		],
		"setup": true,
		"setupDependencies": []
	}
}
