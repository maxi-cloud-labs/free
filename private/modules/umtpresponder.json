{
	"module": "umtpresponder",
	"name": "uMTP-Responder",
	"title": "OTG Files",
	"category": "Server",
	"version": "umtprd-1.8.1",
	"installMethod": "clone",
	"web": false,
	"recommended": false,
	"finished": true,
	"database": "",
	"github": "viveris/uMTP-Responder",
	"description": "A lightweight Linux USB MTP responder for transferring files to connected devices.",
	"hero": "a USB OTG cable bridging a tiny device to a computer, files glowing along the cable. close-up, compact, circuit-board",
	"keywords": [
		"Android",
		"Devices",
		"Files",
		"Linux",
		"Media",
		"Otg",
		"Transfers",
		"Usb"
	],
	"proprietary": [
		"Samsung Smart Switch"
	],
	"default": {
		"cmds": [
			"/usr/local/bin/umtprd"
		],
		"enabled": "true",
		"features": [
			"serial",
			"mtp"
		],
		"mtp": {
			"show_hidden_files": true,
			"path": "/disk/admin",
			"rights": "rw"
		}
	}
}
