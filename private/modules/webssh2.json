{
	"module": "webssh2",
	"name": "WebSSH2",
	"title": "Web SSH Client",
	"category": "Server",
	"version": "v2.3.4",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "",
	"github": "billchurch/webssh2",
	"description": "A browser-based SSH terminal for remotely accessing and administering servers.",
	"hero": "a browser window with a glowing secure tunnel descending into a dark server, cursor blinking. cyberpunk, stealthy, direct",
	"keywords": [
		"administration",
		"console",
		"login",
		"remote",
		"server",
		"shell",
		"sshclient",
		"terminal"
	],
	"proprietary": [
		"SecureCRT",
		"Termius"
	],
	"default": {
		"addConfigBegin": "Alias /access /usr/local/modules/webssh2/access\n\t<Directory /usr/local/modules/webssh2/access>\n\t\tRequire all granted\n\t</Directory>\n\tProxyPass /access !",
		"alias": [
			"ssh"
		],
		"enabled": true,
		"homepage": "/access",
		"localPort": 9595,
		"permissions": [],
		"permissionsPublicForbidden": true,
		"reservedToFirstUser": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 2222,
				"path": "/"
			},
			{
				"type": "ws",
				"port": 2222,
				"path": "/ssh/socket.io"
			}
		],
		"services": [
			"webssh2"
		]
	}
}
