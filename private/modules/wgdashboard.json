{
	"module": "wgdashboard",
	"name": "WGDashboard",
	"title": "VPN Manager",
	"category": "Server",
	"version": "v4.3.1",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "SQLite",
	"github": "WGDashboard/WGDashboard",
	"description": "A web control panel for configuring WireGuard tunnels, peers, and VPN connections.",
	"hero": "a futuristic dashboard of glowing VPN tunnels, a dragon-shaped WireGuard emblem at its center. neon, secure, command-room",
	"keywords": [
		"configuration",
		"connection",
		"key",
		"monitoring",
		"peer",
		"tunnel",
		"vpn",
		"wireguard"
	],
	"proprietary": [
		"NordLayer",
		"Tailscale",
		"Twingate"
	],
	"default": {
		"autoLogin": {
			"inject": [
				{
					"url": "/",
					"form": "form",
					"arg1": "input[id=username]",
					"arg2": "input[id=password]",
					"arg3": "button",
					"val1": 0,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/api/authenticate",
					"arg1": "username",
					"arg2": "password",
					"val1": 0,
					"val2": 2
				}
			]
		},
		"config": true,
		"enabled": true,
		"localPort": 9598,
		"permissions": [],
		"permissionsPublicForbidden": true,
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 10086,
				"path": "/"
			}
		],
		"services": [
			"wireguarddashboard"
		],
		"setup": true,
		"setupDependencies": [],
		"setupRoot": true
	}
}
