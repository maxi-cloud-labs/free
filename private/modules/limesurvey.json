{
	"module": "limesurvey",
	"name": "LimeSurvey",
	"title": "Survey Management",
	"category": "Collaboration",
	"version": "6.15.3+250708",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "MySQL",
	"github": "LimeSurvey/LimeSurvey",
	"description": "A flexible online survey platform for questionnaires, response collection, and research analysis.",
	"hero": "a juicy lime wedge with a glowing questionnaire checklist floating above it. fresh, zesty, playful",
	"keywords": [
		"analytics",
		"branching",
		"form",
		"poll",
		"questionnaire",
		"research",
		"response",
		"survey"
	],
	"proprietary": [
		"Qualtrics",
		"SurveyMonkey",
		"Typeform"
	],
	"default": {
		"autoLogin": {
			"inject": [
				{
					"url": "/index.php/admin/authentication/sa/login",
					"form": "form[name=loginform]",
					"arg1": "input[name=user]",
					"arg2": "input[name=password]",
					"arg3": "button[name=login_submit]",
					"val1": 0,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/index.php/admin/authentication/sa/login",
					"arg1": "username",
					"arg2": "password",
					"val1": 0,
					"val2": 2
				}
			]
		},
		"config": true,
		"enabled": true,
		"followSymLinks": true,
		"localPort": 9485,
		"permissions": [
			"user"
		],
		"reset": true,
		"setup": true,
		"setupDependencies": [
			"mysql"
		],
		"setupRoot": true
	}
}
