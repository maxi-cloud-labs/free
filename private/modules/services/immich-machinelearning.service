[Unit]
Description=Immich Machine Learning
After=network.target
After=syslog.target
StartLimitBurst=5
StartLimitIntervalSec=300s
OnFailure=notify-failure@%n.service

[Service]
Restart=on-failure
RestartMode=direct
Type=simple
StandardOutput=inherit
StandardError=inherit
RestartSec=5s
User=admin
ExecStart=/usr/local/modules/immich/app/machine-learning/venv/bin/
WorkingDirectory=/disk/admin/modules/immich

[Install]
WantedBy=multi-user.target
