[Unit]
Description=Immich
After=network.target
After=syslog.target
StartLimitBurst=5
StartLimitIntervalSec=300s
OnFailure=notify-failure@%n.service

[Service]
Restart=on-failure
RestartMode=direct
Type=simple
StandardOutput=inherit
StandardError=inherit
RestartSec=5s
User=admin
ExecStart=node /usr/local/modules/immich/app/dist/main
WorkingDirectory=/disk/admin/modules/immich
EnvironmentFile=/disk/admin/modules/immich/env

[Install]
WantedBy=multi-user.target
