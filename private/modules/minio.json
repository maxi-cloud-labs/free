{
	"module": "minio",
	"name": "MinIO",
	"title": "Object Storage",
	"category": "Server",
	"version": "RELEASE.2025-10-15T17-29-55Z",
	"installMethod": "clone",
	"web": true,
	"recommended": false,
	"finished": true,
	"database": "",
	"github": "minio/minio",
	"description": "A high-performance S3-compatible object storage server for application files and large datasets.",
	"hero": "a deep glowing blue ocean vault holding countless data buckets floating in the dark. massive, serene, abyssal",
	"keywords": [
		"backup",
		"blob",
		"bucket",
		"objectstorage",
		"replication",
		"s3",
		"storage",
		"upload"
	],
	"proprietary": [
		"Amazon S3",
		"Azure Blob Storage",
		"Google Cloud Storage"
	],
	"default": {
		"addConfigBegin": "Header set Content-Security-Policy \"script-src 'self' 'unsafe-inline';\"",
		"autoLogin": {
			"inject": [
				{
					"url": "/",
					"form": "form",
					"arg1": "input[id=accessKey]",
					"arg2": "input[id=secretKey]",
					"arg3": "button[type=submit]",
					"val1": 0,
					"val2": 2
				}
			],
			"post": [
				{
					"url": "/api/v1/login",
					"arg1": "accessKey",
					"arg2": "secretKey",
					"val1": 0,
					"val2": 2
				}
			]
		},
		"config": true,
		"enabled": true,
		"localPort": 9475,
		"permissions": [
			"user"
		],
		"reset": true,
		"reverseProxy": [
			{
				"type": "http",
				"port": 9001,
				"path": "/"
			},
			{
				"type": "ws",
				"port": 9001,
				"path": "/ws"
			}
		],
		"services": [
			"minio"
		],
		"setup": true,
		"setupDependencies": []
	}
}